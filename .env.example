# ── Database ──────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_USER=market
DB_PASSWORD=market_secret
DB_NAME=market_platform
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ── MinIO ─────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=market-data
MINIO_USE_SSL=false

# ── API ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Data Sources ──────────────────────────────────────────
# Yahoo Finance (dev only - free, no key needed)
YAHOO_FINANCE_ENABLED=true

# SEC EDGAR (free, no key needed, rate-limited)
SEC_EDGAR_USER_AGENT=MarketPlatform/0.1 (ido.sulam@icloud.com)
SEC_EDGAR_ENABLED=true

# Alpha Vantage (free tier - get key at https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=I4KMM0LAOC9FAG1A
ALPHA_VANTAGE_ENABLED=true

# FRED - Federal Reserve Economic Data (free, instant: https://fred.stlouisfed.org/docs/api/api_key.html)
#FRED_API_KEY=

# ── LLM ───────────────────────────────────────────────────
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:32b
LLM_BASE_URL=http://localhost:11434

# ── Observability ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json
